# Keep the build context small and never leak the training stack or data into
# an image whose whole point is to NOT carry torch (~2.5 GB) or raw imagery.
.git/
.venv/
data/
dataset/
results/
runs/
kaggle*/
Archived-Meta-Data/
webapp/models/
webapp/.cache/
__pycache__/
*.pyc
.pytest_cache/
tests/
# All docs, including webapp/README.md. A serving image has no use for them,
# and excluding them from the build context means a doc edit does not
# invalidate the `COPY webapp/` layer and trigger a rebuild.
*.md
